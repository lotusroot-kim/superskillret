# Plugin venv (recreated by scripts/install.sh)
.venv/
.venv-gpu/

# Skill pool is ~300 MB; users only need it if they build the index locally,
# which install.sh does only when the prebuilt HF dataset is unreachable.
skill_pool/

# Embedding artifacts — fetched at install time from
# https://huggingface.co/datasets/youngryankim/superskillret-index-fullcontext
# so they should not live in git.
cache/*.npy
cache/*.jsonl
cache_fullcontext/

# But keep the VERSION stamp and readme so reviewers see what to expect.
!cache/VERSION
!cache/README.md

# ONNX encoder — fetched from
# https://huggingface.co/youngryankim/superskillret-onnx-int8
# Also too big for git.
onnx_model/
onnx_model_int8/

# Python / editor junk
__pycache__/
*.pyc
*.pyo
.DS_Store
*.swp
.idea/
.vscode/

# Daemon runtime files (live under /tmp, not here, but guard in case)
superskillret.sock
superskillret.pid
superskillret.log

# Bootstrap marker written by install.sh when setup finishes.
.installed
